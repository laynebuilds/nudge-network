# Optional if you are logged in with `ant auth login`.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5.
NUDGE_MODEL=
# Max negotiation turns across both twins (default 12).
NUDGE_MAX_TURNS=
# Where Nudge (jasnoorkaur111/imessage-mcp) is checked out, for npm run ingest:nudge.
NUDGE_PATH=~/imessage-mcp
# Hosted setup: invite tokens (id:secret pairs) and who may see the judges view of runs they are not in.
FOUNDER_TOKENS=layne:change-me,jasnoor:change-me
ADMIN_FOUNDERS=layne
# Private Vercel Blob store. Without it, data lives in .data/.
BLOB_READ_WRITE_TOKEN=
